generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums (funnel §1.5 of docs/CRM_ARCHITECTURE.md is source of truth)
// ─────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  COUNSELOR
  ACCOUNTS
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY_CALL
  QUALIFIED
  LINK_SENT
  CONVERTED
  LOST
}

enum LeadSource {
  ORGANIC
  GOOGLE_ADS
  META_ADS
  WHATSAPP
  REFERRAL
  MANUAL
  IMPORT
}

enum ActivityType {
  NOTE
  CALL
  STATUS_CHANGE
  EMAIL
  SYSTEM
}

enum CourseMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum BatchStatus {
  PLANNED
  ENROLLING
  RUNNING
  COMPLETED
  CANCELLED
}

enum LinkStatus {
  SENT
  OPENED
  COMPLETED
  EXPIRED
  REVOKED
}

enum EnrollmentStatus {
  PAYMENT_PENDING
  CONFIRMED
  ONBOARDING
  ACTIVE
  COMPLETED
  WITHDRAWN
  DEFERRED
}

enum ScheduleStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PaymentProvider {
  RAZORPAY
  BANK
  CASH
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CommChannel {
  EMAIL
  WHATSAPP
}

enum CommStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum DocKind {
  ID_PROOF
  CERTIFICATE
  INVOICE_PDF
  EXPORT
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Adopted tables (pre-existing in Supabase — never dropped/renamed in SQL)
// ─────────────────────────────────────────────────────────────

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CareerApplication {
  id                    BigInt    @id @default(autoincrement())
  application_id        String    @unique
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  job_slug              String
  status                String    @default("New")
  internal_notes        String?
  reviewer              String?
  full_name             String
  email                 String
  phone                 String
  whatsapp              String
  gender                String?
  dob                   DateTime? @db.Date
  city                  String
  state                 String
  country               String
  address               String?
  university            String
  college               String?
  degree                String?
  course                String?
  current_year          String?
  graduation_year       String?
  cgpa                  String?
  previous_internship   String?
  leadership_experience String?
  clubs                 String?
  volunteer_work        String?
  event_experience      String?
  skills                String[]  @default([])
  linkedin              String?
  instagram             String?
  portfolio             String?
  github                String?
  why_join              String?
  leadership_story      String?
  promotion_plan        String?
  resume_url            String
  certificates_url      String?
  portfolio_url         String?
  achievements_url      String?
  utm_source            String?
  utm_medium            String?
  utm_campaign          String?
  utm_content           String?
  utm_term              String?
  referrer_url          String?
  device                String?
  browser               String?
  ip_address            String?

  @@index([created_at(sort: Desc)], map: "career_apps_created_at_idx")
  @@index([email], map: "career_apps_email_idx")
  @@index([job_slug], map: "career_apps_job_slug_idx")
  @@index([status], map: "career_apps_status_idx")
  @@map("career_applications")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceCounter {
  year     Int @id
  last_seq Int @default(0)

  @@map("invoice_counters")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceItem {
  id          BigInt  @id @default(autoincrement())
  invoice_id  BigInt
  position    Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  rate        Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(12, 2)
  hsn         String?
  invoice     Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id, position], map: "invoice_items_invoice_id_idx")
  @@map("invoice_items")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Invoice {
  id              BigInt        @id @default(autoincrement())
  invoice_no      String        @unique
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  lead_id         BigInt?
  // One invoice per enrollment. UNIQUE also acts as the DB-level idempotency
  // guard so a webhook retry / callback race can never mint a second invoice.
  enrollment_id   String?       @unique
  bill_name       String
  bill_email      String?
  bill_phone      String?
  bill_company    String?
  bill_gstin      String?
  bill_address    String?
  issue_date      DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date        DateTime?     @db.Date
  currency        String        @default("INR")
  tax_rate        Decimal       @default(18) @db.Decimal(5, 2)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  status          String        @default("draft")
  notes           String?
  seller_gstin    String?
  place_of_supply String?
  bill_state      String?
  items           InvoiceItem[]
  lead            Lead?         @relation(fields: [lead_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([lead_id])
  @@index([status])
  @@map("invoices")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Lead {
  id           BigInt   @id @default(autoincrement())
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  full_name    String
  email        String   @unique
  mobile       String?
  form_type    String   @default("masterclass")
  background   String?
  consent      Boolean  @default(true)
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  landing_page String?
  extra        Json     @default("{}")

  // ── Funnel columns (added in Phase 1) ──
  status               LeadStatus @default(NEW)
  source               LeadSource @default(ORGANIC)
  attribution          Json       @default("{}")
  lost_reason          String?
  assigned_to_id       String?
  course_interest_id   String?
  converted_student_id String?

  invoices         Invoice[]
  activities       Activity[]
  masterclass_registrations MasterclassRegistration[]
  enrollment_links EnrollmentLink[]
  enrollments      Enrollment[]
  assigned_to      StaffUser?       @relation("AssignedLeads", fields: [assigned_to_id], references: [id])
  course_interest  Course?          @relation(fields: [course_interest_id], references: [id])
  converted_student Student?        @relation(fields: [converted_student_id], references: [id])

  @@index([created_at(sort: Desc)])
  @@index([form_type])
  @@index([status, assigned_to_id])
  @@index([source])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────
// New tables (Phase 1 — funnel core)
// ─────────────────────────────────────────────────────────────

model StaffUser {
  id            String    @id @default(cuid())
  clerk_user_id String    @unique
  name          String
  email         String    @unique
  role          StaffRole @default(VIEWER)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  assigned_leads Lead[]           @relation("AssignedLeads")
  activities     Activity[]
  sent_links     EnrollmentLink[]

  @@map("staff_users")
}

model Student {
  id            String   @id @default(cuid())
  clerk_user_id String?  @unique
  full_name     String
  email         String   @unique
  phone         String?
  whatsapp      String?
  city          String?
  state         String?
  qualification String?
  extra         Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  enrollments          Enrollment[]
  activities           Activity[]
  converted_from_leads Lead[]

  @@index([phone])
  @@map("students")
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  body          String
  lead_id       BigInt?
  student_id    String?
  enrollment_id String?
  actor_id      String?
  created_at    DateTime     @default(now()) @db.Timestamptz(6)

  lead       Lead?       @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  student    Student?    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  actor      StaffUser?  @relation(fields: [actor_id], references: [id])

  @@index([lead_id, created_at(sort: Desc)])
  @@index([student_id, created_at(sort: Desc)])
  @@index([enrollment_id, created_at(sort: Desc)])
  @@map("activities")
}

model Course {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  description      String?
  base_price_paise Int
  gst_rate_pct     Decimal    @default(18) @db.Decimal(5, 2)
  hsn_sac          String?
  duration_weeks   Int?
  mode             CourseMode @default(ONLINE)
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @updatedAt @db.Timestamptz(6)

  batches        Batch[]
  interested_leads Lead[]

  @@map("courses")
}

model Batch {
  id            String      @id @default(cuid())
  course_id     String
  name          String
  start_date    DateTime?   @db.Date
  end_date      DateTime?   @db.Date
  seat_capacity Int         @default(20)
  status        BatchStatus @default(PLANNED)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @updatedAt @db.Timestamptz(6)

  course           Course           @relation(fields: [course_id], references: [id])
  enrollments      Enrollment[]
  enrollment_links EnrollmentLink[]

  @@index([course_id, status])
  @@map("batches")
}

model EnrollmentLink {
  id             String     @id @default(cuid())
  token          String     @unique
  lead_id        BigInt
  batch_id       String
  price_paise    Int
  discount_paise Int        @default(0)
  status         LinkStatus @default(SENT)
  expires_at     DateTime   @db.Timestamptz(6)
  sent_by_id     String?
  enrollment_id  String?    @unique
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)

  lead       Lead        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  batch      Batch       @relation(fields: [batch_id], references: [id])
  sent_by    StaffUser?  @relation(fields: [sent_by_id], references: [id])
  enrollment Enrollment? @relation(fields: [enrollment_id], references: [id])

  @@index([lead_id])
  @@index([status, expires_at])
  @@map("enrollment_links")
}

model Enrollment {
  id             String           @id @default(cuid())
  student_id     String
  batch_id       String
  status         EnrollmentStatus @default(PAYMENT_PENDING)
  price_paise    Int
  discount_paise Int              @default(0)
  source_lead_id BigInt?
  // Fulfillment state, tracked SEPARATELY from payment state so invoice/email
  // can be retried without ever touching the (authoritative) payment record.
  welcome_email_sent_at DateTime? @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @updatedAt @db.Timestamptz(6)

  student     Student              @relation(fields: [student_id], references: [id])
  batch       Batch                @relation(fields: [batch_id], references: [id])
  source_lead Lead?                @relation(fields: [source_lead_id], references: [id])
  link        EnrollmentLink?
  schedules   PaymentSchedule[]
  transactions PaymentTransaction[]
  activities  Activity[]

  @@unique([student_id, batch_id])
  @@index([batch_id, status])
  @@map("enrollments")
}

model PaymentSchedule {
  id            String         @id @default(cuid())
  enrollment_id String
  seq           Int
  due_date      DateTime       @db.Date
  amount_paise  Int
  status        ScheduleStatus @default(PENDING)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  enrollment   Enrollment           @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([enrollment_id, seq])
  @@index([status, due_date])
  @@map("payment_schedules")
}

model PaymentTransaction {
  id                  String          @id @default(cuid())
  enrollment_id       String
  schedule_id         String?
  provider            PaymentProvider @default(RAZORPAY)
  provider_order_id   String?
  provider_payment_id String?         @unique
  amount_paise        Int
  status              PaymentStatus   @default(CREATED)
  method              String?
  raw_payload         Json            @default("{}")
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @updatedAt @db.Timestamptz(6)

  enrollment Enrollment       @relation(fields: [enrollment_id], references: [id])
  schedule   PaymentSchedule? @relation(fields: [schedule_id], references: [id])

  @@index([enrollment_id])
  @@index([provider_order_id])
  @@map("payment_transactions")
}

model CommunicationLog {
  id                  String      @id @default(cuid())
  channel             CommChannel
  to_addr             String
  template_key        String
  entity_ref          String?
  provider_message_id String?
  status              CommStatus  @default(QUEUED)
  error               String?
  created_at          DateTime    @default(now()) @db.Timestamptz(6)

  @@index([entity_ref])
  @@index([created_at(sort: Desc)])
  @@map("communication_logs")
}

model Document {
  id             String   @id @default(cuid())
  owner_type     String
  owner_id       String
  kind           DocKind  @default(OTHER)
  r2_key         String
  mime           String?
  size_bytes     Int?
  uploaded_by_id String?
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_type, owner_id])
  @@map("documents")
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_id    String?
  action      String
  entity_type String
  entity_id   String
  before      Json?
  after       Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // ── CMS extension ──
  // CRM writes (leads, enrollments) set actor_id → StaffUser. CMS writes set
  // cms_user_id → CmsUser. entity_name is the human label shown in the CMS
  // activity feed ("Gagan Victor") so the log stays readable after a delete.
  cms_user_id String? @db.Uuid
  entity_name String?

  cms_user CmsUser? @relation(fields: [cms_user_id], references: [id])

  @@index([entity_type, entity_id, created_at(sort: Desc)])
  @@index([cms_user_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("audit_logs")
}

/// Failed admin-passcode attempts per client, shared across serverless
/// instances. See src/lib/rate-limit.ts — rows are written with raw SQL so the
/// increment and its window reset happen in one statement.
model AdminAuthAttempt {
  key          String   @id
  failures     Int      @default(0)
  window_start DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([window_start])
  @@map("admin_auth_attempts")
}

model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String
  event_id     String
  type         String
  payload      Json
  processed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([provider, event_id])
  @@map("webhook_events")
}

// ═════════════════════════════════════════════════════════════
// CMS v1 — content managed by non-technical staff via /admin.
//
// Scope: cohort settings, success stories, faculty. Everything here is
// PUBLIC marketing content. It is deliberately kept separate from the CRM
// funnel above: editing the marketing cohort date must never change what a
// paying customer is enrolled into (that stays Batch.start_date).
// ═════════════════════════════════════════════════════════════

enum CmsRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  CONTENT_EDITOR
}

enum CmsUserStatus {
  ACTIVE
  DISABLED
}

enum AdmissionsStatus {
  OPEN
  CLOSING_SOON
  CLOSED
  COMING_SOON
}

enum AlumniCategory {
  COHORT_ALUMNI
  ADVANCED_MODULE_ALUMNI
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// The admin whitelist. A person can reach the CMS only if they have a row
/// here with status ACTIVE — an @medskillscatalyst.com address alone is never
/// sufficient. Passwords are scrypt hashes (see src/lib/password.ts).
model CmsUser {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  full_name     String
  password_hash String
  role          CmsRole       @default(CONTENT_EDITOR)
  status        CmsUserStatus @default(ACTIVE)
  last_login_at DateTime?     @db.Timestamptz(6)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  sessions         CmsSession[]
  activity         AuditLog[]
  content_versions ContentVersion[]
  cohort_updates   CohortSetting[]

  @@index([status])
  @@map("cms_users")
}

/// Server-side session records, so deactivating a user kills their live
/// sessions immediately. The cookie carries a random token; only its SHA-256
/// hash is stored, so a database leak cannot be replayed as a login.
model CmsSession {
  id         String   @id @default(uuid()) @db.Uuid
  token_hash String   @unique
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user_agent String?

  user CmsUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("cms_sessions")
}

/// Single source of truth for every cohort date/status shown on the public
/// site. Exactly one row may have is_active = true (partial unique index).
model CohortSetting {
  id                String           @id @default(uuid()) @db.Uuid
  cohort_name       String
  start_date        DateTime         @db.Date
  /// Canonical 24-hour time-of-day, "HH:mm" (e.g. "18:00"). Stored zone-free
  /// exactly like a SQL TIME; all display formatting happens in the view layer.
  start_time        String?          @db.VarChar(5)
  admissions_status AdmissionsStatus @default(OPEN)
  duration          String?
  registration_url  String?
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @updatedAt @db.Timestamptz(6)
  updated_by_id     String?          @db.Uuid

  updated_by CmsUser? @relation(fields: [updated_by_id], references: [id])

  @@index([is_active])
  @@map("cohort_settings")
}

model SuccessStory {
  id                  String         @id @default(uuid()) @db.Uuid
  category            AlumniCategory
  full_name           String
  profile_image_url   String?
  linkedin_url        String?
  previous_company    String?
  previous_designation String?
  current_company     String?
  current_designation String?
  growth_headline     String?
  growth_description  String?
  short_description   String?
  full_story          String?
  testimonial         String?
  status              ContentStatus  @default(DRAFT)
  /// Ordering is scoped per category — see the composite index below.
  display_order       Int            @default(0)
  created_by_id       String?        @db.Uuid
  updated_by_id       String?        @db.Uuid
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @updatedAt @db.Timestamptz(6)
  published_at        DateTime?      @db.Timestamptz(6)
  archived_at         DateTime?      @db.Timestamptz(6)
  deleted_at          DateTime?      @db.Timestamptz(6)

  @@index([category, status, display_order])
  @@index([status])
  @@index([deleted_at])
  @@map("success_stories")
}

model Faculty {
  id                String        @id @default(uuid()) @db.Uuid
  full_name         String
  profile_image_url String?
  designation       String
  organization      String?
  years_experience  Int?
  experience_display String?
  short_bio         String?
  full_bio          String?
  status            ContentStatus @default(DRAFT)
  display_order     Int           @default(0)
  created_by_id     String?       @db.Uuid
  updated_by_id     String?       @db.Uuid
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @updatedAt @db.Timestamptz(6)
  published_at      DateTime?     @db.Timestamptz(6)
  archived_at       DateTime?     @db.Timestamptz(6)
  deleted_at        DateTime?     @db.Timestamptz(6)

  expertise FacultyExpertise[]

  @@index([status, display_order])
  @@index([deleted_at])
  @@map("faculty")
}

model FacultyExpertise {
  id             String @id @default(uuid()) @db.Uuid
  faculty_id     String @db.Uuid
  expertise_name String
  display_order  Int    @default(0)

  faculty Faculty @relation(fields: [faculty_id], references: [id], onDelete: Cascade)

  @@index([faculty_id, display_order])
  @@map("faculty_expertise")
}

/// Append-only content snapshots. Never updated, never deleted — a rollback
/// writes a NEW version rather than rewinding history.
model ContentVersion {
  id             String   @id @default(uuid()) @db.Uuid
  entity_type    String
  entity_id      String
  version_number Int
  content_data   Json
  created_by_id  String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  created_by CmsUser? @relation(fields: [created_by_id], references: [id])

  @@unique([entity_type, entity_id, version_number])
  @@index([entity_type, entity_id, version_number(sort: Desc)])
  @@map("content_versions")
}

/// Failed CMS sign-in attempts, one row each, used for sliding-window rate
/// limiting. Rows are written ONLY on failure and pruned by age, so the table
/// stays small. This is also the audit trail for password-guessing attempts.
///
/// Deliberately not tied to CmsUser: attempts against addresses that have no
/// account must be counted too, otherwise the rate limiter itself would become
/// a user-enumeration oracle.
model CmsLoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  /// The lower-cased email that was submitted. Not a foreign key — see above.
  identifier String
  /// Best-effort client IP. Advisory only: see src/lib/cms-rate-limit.ts.
  ip         String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier, created_at])
  @@index([ip, created_at])
  @@map("cms_login_attempts")
}

// ─────────────────────────────────────────────────────────────
// Masterclass registrations (src/modules/masterclass)
// ─────────────────────────────────────────────────────────────

/// Where the student is in their studies — NOT a calendar graduation year.
enum MasterclassAcademicStatus {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  GRADUATE
}

/// Lifecycle of the Zoom confirmation email. SENT means Resend accepted the
/// message and returned an id — never set on a guess.
enum MasterclassEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// One row per student per event. Every registration is also mirrored into
/// `leads` (lead_id) so it shows up in the CRM.
model MasterclassRegistration {
  id                   String                    @id @default(cuid())
  event_key            String
  full_name            String
  /// Trimmed + lower-cased before storage.
  email                String
  /// E.164, e.g. +919876543210.
  phone                String
  university           String
  /// "directory" when picked from the AISHE list, "manual" when typed in.
  university_source    String                    @default("manual")
  academic_status      MasterclassAcademicStatus
  consent_at           DateTime                  @db.Timestamptz(6)
  consent_text_version String
  utm_source           String?
  utm_medium           String?
  utm_campaign         String?
  utm_content          String?
  utm_term             String?
  gclid                String?
  fbclid               String?
  referrer             String?
  landing_page         String?
  lead_id              BigInt?

  email_status         MasterclassEmailStatus    @default(PENDING)
  email_attempts       Int                       @default(0)
  email_last_error     String?
  email_provider_id    String?
  email_sent_at        DateTime?                 @db.Timestamptz(6)
  email_next_attempt_at DateTime?                @db.Timestamptz(6)
  /// Set when a worker claims the row (SENDING); a stale claim is reclaimable.
  email_claimed_at     DateTime?                 @db.Timestamptz(6)

  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                  @updatedAt @db.Timestamptz(6)

  lead Lead? @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@unique([event_key, email])
  @@unique([event_key, phone])
  @@index([event_key, created_at(sort: Desc)])
  @@index([email_status, email_next_attempt_at])
  @@index([lead_id])
  @@map("masterclass_registrations")
}
