generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums (funnel §1.5 of docs/CRM_ARCHITECTURE.md is source of truth)
// ─────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  COUNSELOR
  ACCOUNTS
  VIEWER
  ISSUER
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY_CALL
  QUALIFIED
  LINK_SENT
  CONVERTED
  LOST
}

enum LeadSource {
  ORGANIC
  GOOGLE_ADS
  META_ADS
  WHATSAPP
  REFERRAL
  MANUAL
  IMPORT
}

enum ActivityType {
  NOTE
  CALL
  STATUS_CHANGE
  EMAIL
  SYSTEM
}

enum CourseMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum BatchStatus {
  PLANNED
  ENROLLING
  RUNNING
  COMPLETED
  CANCELLED
}

enum LinkStatus {
  SENT
  OPENED
  COMPLETED
  EXPIRED
  REVOKED
}

enum EnrollmentStatus {
  PAYMENT_PENDING
  CONFIRMED
  ONBOARDING
  ACTIVE
  COMPLETED
  WITHDRAWN
  DEFERRED
}

enum ScheduleStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PaymentProvider {
  RAZORPAY
  BANK
  CASH
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CommChannel {
  EMAIL
  WHATSAPP
}

enum CommStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum DocKind {
  ID_PROOF
  CERTIFICATE
  INVOICE_PDF
  EXPORT
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Adopted tables (pre-existing in Supabase — never dropped/renamed in SQL)
// ─────────────────────────────────────────────────────────────

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CareerApplication {
  id                    BigInt    @id @default(autoincrement())
  application_id        String    @unique
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  job_slug              String
  status                String    @default("New")
  internal_notes        String?
  reviewer              String?
  full_name             String
  email                 String
  phone                 String
  whatsapp              String
  gender                String?
  dob                   DateTime? @db.Date
  city                  String
  state                 String
  country               String
  address               String?
  university            String
  college               String?
  degree                String?
  course                String?
  current_year          String?
  graduation_year       String?
  cgpa                  String?
  previous_internship   String?
  leadership_experience String?
  clubs                 String?
  volunteer_work        String?
  event_experience      String?
  skills                String[]  @default([])
  linkedin              String?
  instagram             String?
  portfolio             String?
  github                String?
  why_join              String?
  leadership_story      String?
  promotion_plan        String?
  resume_url            String
  certificates_url      String?
  portfolio_url         String?
  achievements_url      String?
  utm_source            String?
  utm_medium            String?
  utm_campaign          String?
  utm_content           String?
  utm_term              String?
  referrer_url          String?
  device                String?
  browser               String?
  ip_address            String?

  @@index([created_at(sort: Desc)], map: "career_apps_created_at_idx")
  @@index([email], map: "career_apps_email_idx")
  @@index([job_slug], map: "career_apps_job_slug_idx")
  @@index([status], map: "career_apps_status_idx")
  @@map("career_applications")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceCounter {
  year     Int @id
  last_seq Int @default(0)

  @@map("invoice_counters")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceItem {
  id          BigInt  @id @default(autoincrement())
  invoice_id  BigInt
  position    Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  rate        Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(12, 2)
  hsn         String?
  invoice     Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id, position], map: "invoice_items_invoice_id_idx")
  @@map("invoice_items")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Invoice {
  id              BigInt        @id @default(autoincrement())
  invoice_no      String        @unique
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  lead_id         BigInt?
  // One invoice per enrollment. UNIQUE also acts as the DB-level idempotency
  // guard so a webhook retry / callback race can never mint a second invoice.
  enrollment_id   String?       @unique
  bill_name       String
  bill_email      String?
  bill_phone      String?
  bill_company    String?
  bill_gstin      String?
  bill_address    String?
  issue_date      DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date        DateTime?     @db.Date
  currency        String        @default("INR")
  tax_rate        Decimal       @default(18) @db.Decimal(5, 2)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  status          String        @default("draft")
  notes           String?
  seller_gstin    String?
  place_of_supply String?
  bill_state      String?
  items           InvoiceItem[]
  lead            Lead?         @relation(fields: [lead_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([lead_id])
  @@index([status])
  @@map("invoices")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Lead {
  id           BigInt   @id @default(autoincrement())
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  full_name    String
  email        String   @unique
  mobile       String?
  form_type    String   @default("masterclass")
  background   String?
  consent      Boolean  @default(true)
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  landing_page String?
  extra        Json     @default("{}")

  // ── Funnel columns (added in Phase 1) ──
  status               LeadStatus @default(NEW)
  source               LeadSource @default(ORGANIC)
  attribution          Json       @default("{}")
  lost_reason          String?
  assigned_to_id       String?
  course_interest_id   String?
  converted_student_id String?

  invoices         Invoice[]
  activities       Activity[]
  masterclass_registrations MasterclassRegistration[]
  enrollment_links EnrollmentLink[]
  enrollments      Enrollment[]
  assigned_to      StaffUser?       @relation("AssignedLeads", fields: [assigned_to_id], references: [id])
  course_interest  Course?          @relation(fields: [course_interest_id], references: [id])
  converted_student Student?        @relation(fields: [converted_student_id], references: [id])

  @@index([created_at(sort: Desc)])
  @@index([form_type])
  @@index([status, assigned_to_id])
  @@index([source])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────
// New tables (Phase 1 — funnel core)
// ─────────────────────────────────────────────────────────────

model StaffUser {
  id            String    @id @default(cuid())
  clerk_user_id String    @unique
  name          String
  email         String    @unique
  role          StaffRole @default(VIEWER)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  assigned_leads Lead[]           @relation("AssignedLeads")
  activities     Activity[]
  sent_links     EnrollmentLink[]

  credentials_created   Credential[]              @relation("CredentialCreatedBy")
  credentials_revoked   Credential[]              @relation("CredentialRevokedBy")
  credential_events     CredentialEvent[]
  templates_created     CertificateTemplate[]
  email_deliveries      CredentialEmailDelivery[]
  bulk_jobs_created     CredentialBulkJob[]       @relation("BulkJobCreatedBy")
  bulk_jobs_confirmed   CredentialBulkJob[]       @relation("BulkJobConfirmedBy")

  @@map("staff_users")
}

model Student {
  id            String   @id @default(cuid())
  clerk_user_id String?  @unique
  full_name     String
  email         String   @unique
  phone         String?
  whatsapp      String?
  city          String?
  state         String?
  qualification String?
  extra         Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  enrollments          Enrollment[]
  activities           Activity[]
  converted_from_leads Lead[]
  credentials          Credential[]

  @@index([phone])
  @@map("students")
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  body          String
  lead_id       BigInt?
  student_id    String?
  enrollment_id String?
  actor_id      String?
  created_at    DateTime     @default(now()) @db.Timestamptz(6)

  lead       Lead?       @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  student    Student?    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  actor      StaffUser?  @relation(fields: [actor_id], references: [id])

  @@index([lead_id, created_at(sort: Desc)])
  @@index([student_id, created_at(sort: Desc)])
  @@index([enrollment_id, created_at(sort: Desc)])
  @@map("activities")
}

model Course {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  description      String?
  base_price_paise Int
  gst_rate_pct     Decimal    @default(18) @db.Decimal(5, 2)
  hsn_sac          String?
  duration_weeks   Int?
  mode             CourseMode @default(ONLINE)
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @updatedAt @db.Timestamptz(6)

  // ── Credential configuration (credential system, 2026-09) ──
  /// Program code used in certificate IDs (MSC-{YEAR}-{CODE}-{RANDOM}). Set by an admin.
  code              String?  @unique
  /// null = credentials from this program never expire.
  validity_months   Int?
  /// What expires_at is counted from: COMPLETION (completion date) or ISSUE (issue date).
  validity_anchor   String   @default("COMPLETION")
  /// Program title as printed on certificates / verification page (defaults to name).
  certificate_title String?
  /// The one credential type this program issues. Fixed once it has issued (DB trigger).
  credential_type   CredentialType @default(COURSE_COMPLETION)

  batches        Batch[]
  interested_leads Lead[]
  certificate_templates CertificateTemplate[]
  credentials           Credential[]
  credential_bulk_jobs  CredentialBulkJob[]

  @@map("courses")
}

model Batch {
  id            String      @id @default(cuid())
  course_id     String
  name          String
  start_date    DateTime?   @db.Date
  end_date      DateTime?   @db.Date
  seat_capacity Int         @default(20)
  status        BatchStatus @default(PLANNED)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @updatedAt @db.Timestamptz(6)

  course           Course           @relation(fields: [course_id], references: [id])
  enrollments      Enrollment[]
  enrollment_links EnrollmentLink[]
  credentials      Credential[]
  credential_bulk_jobs CredentialBulkJob[]

  @@index([course_id, status])
  @@map("batches")
}

model EnrollmentLink {
  id             String     @id @default(cuid())
  token          String     @unique
  lead_id        BigInt
  batch_id       String
  price_paise    Int
  discount_paise Int        @default(0)
  status         LinkStatus @default(SENT)
  expires_at     DateTime   @db.Timestamptz(6)
  sent_by_id     String?
  enrollment_id  String?    @unique
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)

  lead       Lead        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  batch      Batch       @relation(fields: [batch_id], references: [id])
  sent_by    StaffUser?  @relation(fields: [sent_by_id], references: [id])
  enrollment Enrollment? @relation(fields: [enrollment_id], references: [id])

  @@index([lead_id])
  @@index([status, expires_at])
  @@map("enrollment_links")
}

model Enrollment {
  id             String           @id @default(cuid())
  student_id     String
  batch_id       String
  status         EnrollmentStatus @default(PAYMENT_PENDING)
  price_paise    Int
  discount_paise Int              @default(0)
  source_lead_id BigInt?
  // Fulfillment state, tracked SEPARATELY from payment state so invoice/email
  // can be retried without ever touching the (authoritative) payment record.
  welcome_email_sent_at DateTime? @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @updatedAt @db.Timestamptz(6)

  student     Student              @relation(fields: [student_id], references: [id])
  batch       Batch                @relation(fields: [batch_id], references: [id])
  source_lead Lead?                @relation(fields: [source_lead_id], references: [id])
  link        EnrollmentLink?
  schedules   PaymentSchedule[]
  transactions PaymentTransaction[]
  activities  Activity[]

  @@unique([student_id, batch_id])
  @@index([batch_id, status])
  @@map("enrollments")
}

model PaymentSchedule {
  id            String         @id @default(cuid())
  enrollment_id String
  seq           Int
  due_date      DateTime       @db.Date
  amount_paise  Int
  status        ScheduleStatus @default(PENDING)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  enrollment   Enrollment           @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([enrollment_id, seq])
  @@index([status, due_date])
  @@map("payment_schedules")
}

model PaymentTransaction {
  id                  String          @id @default(cuid())
  enrollment_id       String
  schedule_id         String?
  provider            PaymentProvider @default(RAZORPAY)
  provider_order_id   String?
  provider_payment_id String?         @unique
  amount_paise        Int
  status              PaymentStatus   @default(CREATED)
  method              String?
  raw_payload         Json            @default("{}")
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @updatedAt @db.Timestamptz(6)

  enrollment Enrollment       @relation(fields: [enrollment_id], references: [id])
  schedule   PaymentSchedule? @relation(fields: [schedule_id], references: [id])

  @@index([enrollment_id])
  @@index([provider_order_id])
  @@map("payment_transactions")
}

model CommunicationLog {
  id                  String      @id @default(cuid())
  channel             CommChannel
  to_addr             String
  template_key        String
  entity_ref          String?
  provider_message_id String?
  status              CommStatus  @default(QUEUED)
  error               String?
  created_at          DateTime    @default(now()) @db.Timestamptz(6)

  @@index([entity_ref])
  @@index([created_at(sort: Desc)])
  @@map("communication_logs")
}

model Document {
  id             String   @id @default(cuid())
  owner_type     String
  owner_id       String
  kind           DocKind  @default(OTHER)
  r2_key         String
  mime           String?
  size_bytes     Int?
  uploaded_by_id String?
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_type, owner_id])
  @@map("documents")
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_id    String?
  action      String
  entity_type String
  entity_id   String
  before      Json?
  after       Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id, created_at(sort: Desc)])
  @@map("audit_logs")
}

/// Failed admin-passcode attempts per client, shared across serverless
/// instances. See src/lib/rate-limit.ts — rows are written with raw SQL so the
/// increment and its window reset happen in one statement.
model AdminAuthAttempt {
  key          String   @id
  failures     Int      @default(0)
  window_start DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([window_start])
  @@map("admin_auth_attempts")
}

model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String
  event_id     String
  type         String
  payload      Json
  processed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([provider, event_id])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
// Credential system (migration 20260925120000_credentials)
// The credential registry is the source of truth; the PDF is a rendering.
// DB triggers enforce: no deletes, immutable identifiers/printed content after
// issue, terminal REVOKED/SUPERSEDED, append-only events, frozen active templates.
// ─────────────────────────────────────────────────────────────

/// Credential types (2026-10-04). Add a value with an additive migration + a
/// registry entry in src/modules/credentials/credential-types.ts.
enum CredentialType {
  COURSE_COMPLETION
  INTERNSHIP_COMPLETION
  OFFER_LETTER
}

enum CredentialStatus {
  ISSUING
  VALID
  REVOKED
  SUPERSEDED
  FAILED
}

enum CertificateTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CredentialEventType {
  ISSUE_REQUESTED
  PDF_GENERATED
  RENDER_FAILED
  ISSUED
  EMAIL_SENT
  EMAIL_FAILED
  EMAIL_SUPPRESSED
  EMAIL_RESENT
  REVOKED
  REISSUED
  SUPERSEDED
  STATUS_CHANGED
}

enum CredentialEmailStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum CredentialBulkJobStatus {
  VALIDATED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CredentialBulkRowValidation {
  VALID
  WARNING
  ERROR
}

enum CredentialBulkRowOutcome {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  DUPLICATE
}

model CertificateTemplate {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id     String
  version       Int
  name          String
  status        CertificateTemplateStatus @default(DRAFT)
  /// false for the development template: refused for issuance on production.
  is_production Boolean                   @default(false)
  /// { kind: "builtin-dev" } | { kind: "storage", path, sha256, mime }
  background    Json
  /// Page size + dynamic field boxes + QR box. See src/modules/credentials/template-config.ts
  field_config  Json
  /// Signature blocks for this template (per template, not global).
  signatures    Json                      @default("[]")
  notes         String?
  created_by_id String?
  activated_at  DateTime?                 @db.Timestamptz(6)
  retired_at    DateTime?                 @db.Timestamptz(6)
  created_at    DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                  @updatedAt @db.Timestamptz(6)

  course      Course              @relation(fields: [course_id], references: [id])
  created_by  StaffUser?          @relation(fields: [created_by_id], references: [id])
  credentials Credential[]
  bulk_jobs   CredentialBulkJob[]

  @@unique([course_id, version])
  @@index([course_id, status])
  @@map("certificate_templates")
}

model Credential {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificate_id     String           @unique
  verification_token String           @unique
  idempotency_key    String           @unique
  student_id         String
  course_id          String
  batch_id           String?
  template_id        String           @db.Uuid
  /// Snapshot of what is printed, so later profile edits never change an issued credential.
  learner_name       String
  program_name       String
  completion_date    DateTime         @db.Date
  /// Snapshot of the program's type. Immutable.
  credential_type    CredentialType   @default(COURSE_COMPLETION)
  /// Type-specific details (e.g. internship title/dates/duration), validated by the type registry. Frozen once issued.
  details            Json             @default("{}")
  /// Used for the duplicate rule when there is no cohort.
  completion_context String?
  issued_at          DateTime         @db.Timestamptz(6)
  expires_at         DateTime?        @db.Date
  /// Stored lifecycle state. EXPIRED is derived at read time from expires_at.
  status             CredentialStatus @default(ISSUING)
  /// learner+program+cohort (or completion context). Unique among ISSUING/VALID (partial index in SQL).
  dedupe_key         String?
  source             String           @default("SINGLE")
  pdf_path           String?
  pdf_sha256         String?
  render_attempts    Int              @default(0)
  lease_until        DateTime?        @db.Timestamptz(6)
  last_error         String?
  supersedes_id      String?          @unique @db.Uuid
  revoked_at         DateTime?        @db.Timestamptz(6)
  revoked_by_id      String?
  /// INTERNAL ONLY. Never included in any public payload.
  revocation_reason  String?
  created_by_id      String
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @updatedAt @db.Timestamptz(6)

  student       Student                   @relation(fields: [student_id], references: [id])
  course        Course                    @relation(fields: [course_id], references: [id])
  batch         Batch?                    @relation(fields: [batch_id], references: [id])
  template      CertificateTemplate       @relation(fields: [template_id], references: [id])
  supersedes    Credential?               @relation("CredentialSupersedes", fields: [supersedes_id], references: [id])
  superseded_by Credential?               @relation("CredentialSupersedes")
  created_by    StaffUser                 @relation("CredentialCreatedBy", fields: [created_by_id], references: [id])
  revoked_by    StaffUser?                @relation("CredentialRevokedBy", fields: [revoked_by_id], references: [id])
  events        CredentialEvent[]
  deliveries    CredentialEmailDelivery[]
  bulk_rows     CredentialBulkRow[]

  @@index([student_id])
  @@index([course_id, batch_id])
  @@index([status])
  @@index([issued_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([credential_type, issued_at(sort: Desc)])
  @@map("credentials")
}

model CredentialEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credential_id String              @db.Uuid
  type          CredentialEventType
  actor_id      String?
  metadata      Json                @default("{}")
  created_at    DateTime            @default(now()) @db.Timestamptz(6)

  credential Credential @relation(fields: [credential_id], references: [id], onDelete: Restrict)
  actor      StaffUser? @relation(fields: [actor_id], references: [id])

  @@index([credential_id, created_at(sort: Desc)])
  @@index([type, created_at(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("credential_events")
}

model CredentialEmailDelivery {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credential_id       String                @db.Uuid
  /// ISSUED | RESEND
  kind                String
  recipient           String
  status              CredentialEmailStatus @default(PENDING)
  provider_message_id String?
  attempts            Int                   @default(0)
  last_error          String?
  last_attempt_at     DateTime?             @db.Timestamptz(6)
  triggered_by_id     String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @updatedAt @db.Timestamptz(6)

  credential   Credential @relation(fields: [credential_id], references: [id], onDelete: Restrict)
  triggered_by StaffUser? @relation(fields: [triggered_by_id], references: [id])

  @@index([credential_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@map("credential_email_deliveries")
}

model CredentialBulkJob {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id       String
  batch_id        String?
  template_id     String                  @db.Uuid
  file_name       String
  file_sha256     String
  status          CredentialBulkJobStatus @default(VALIDATED)
  send_email      Boolean                 @default(true)
  credential_type CredentialType          @default(COURSE_COMPLETION)
  total_rows      Int                     @default(0)
  created_by_id   String
  confirmed_by_id String?
  confirmed_at    DateTime?               @db.Timestamptz(6)
  completed_at    DateTime?               @db.Timestamptz(6)
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                @updatedAt @db.Timestamptz(6)

  course       Course              @relation(fields: [course_id], references: [id])
  batch        Batch?              @relation(fields: [batch_id], references: [id])
  template     CertificateTemplate @relation(fields: [template_id], references: [id])
  created_by   StaffUser           @relation("BulkJobCreatedBy", fields: [created_by_id], references: [id])
  confirmed_by StaffUser?          @relation("BulkJobConfirmedBy", fields: [confirmed_by_id], references: [id])
  rows         CredentialBulkRow[]

  @@index([created_at(sort: Desc)])
  @@map("credential_bulk_jobs")
}

model CredentialBulkRow {
  id            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id        String                      @db.Uuid
  row_number    Int
  input         Json
  validation    CredentialBulkRowValidation
  messages      Json                        @default("[]")
  outcome       CredentialBulkRowOutcome    @default(PENDING)
  credential_id String?                     @db.Uuid
  error         String?
  processed_at  DateTime?                   @db.Timestamptz(6)

  job        CredentialBulkJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  credential Credential?       @relation(fields: [credential_id], references: [id])

  @@unique([job_id, row_number])
  @@index([job_id, outcome])
  @@map("credential_bulk_rows")
}

// ─────────────────────────────────────────────────────────────
// Masterclass registrations (src/modules/masterclass)
// ─────────────────────────────────────────────────────────────

/// Where the student is in their studies — NOT a calendar graduation year.
enum MasterclassAcademicStatus {
  // Year-based values from the first release; kept for registrations already stored.
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  GRADUATE
  SEMESTER_1
  SEMESTER_2
  SEMESTER_3
  SEMESTER_4
  SEMESTER_5
  SEMESTER_6
  SEMESTER_7
  SEMESTER_8
}

/// Lifecycle of the Zoom confirmation email. SENT means Resend accepted the
/// message and returned an id — never set on a guess.
enum MasterclassEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// NOT_REQUIRED: registered during the free offer. PENDING: a ₹999 order exists
/// but no captured payment yet. PAID only after a verified Razorpay capture.
enum MasterclassPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
}

/// One row per student per event. Every registration is also mirrored into
/// `leads` (lead_id) so it shows up in the CRM.
model MasterclassRegistration {
  id                   String                    @id @default(cuid())
  event_key            String
  full_name            String
  /// Trimmed + lower-cased before storage.
  email                String
  /// E.164, e.g. +919876543210.
  phone                String
  university           String
  /// "directory" when picked from the AISHE list, "manual" when typed in.
  university_source    String                    @default("manual")
  /// Degree course, e.g. "B.Pharm". Null on registrations made before the field existed.
  course               String?
  /// "list" when picked from the dropdown, "other" when typed in.
  course_source        String?
  academic_status      MasterclassAcademicStatus
  consent_at           DateTime                  @db.Timestamptz(6)
  consent_text_version String
  utm_source           String?
  utm_medium           String?
  utm_campaign         String?
  utm_content          String?
  utm_term             String?
  gclid                String?
  fbclid               String?
  referrer             String?
  landing_page         String?
  lead_id              BigInt?

  email_status         MasterclassEmailStatus    @default(PENDING)
  email_attempts       Int                       @default(0)
  email_last_error     String?
  email_provider_id    String?
  email_sent_at        DateTime?                 @db.Timestamptz(6)
  email_next_attempt_at DateTime?                @db.Timestamptz(6)
  /// Set when a worker claims the row (SENDING); a stale claim is reclaimable.
  email_claimed_at     DateTime?                 @db.Timestamptz(6)

  amount_paise         Int                       @default(0)
  payment_status       MasterclassPaymentStatus  @default(NOT_REQUIRED)
  razorpay_order_id    String?                   @unique
  razorpay_payment_id  String?                   @unique
  paid_at              DateTime?                 @db.Timestamptz(6)

  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                  @updatedAt @db.Timestamptz(6)

  lead Lead? @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@unique([event_key, email])
  @@unique([event_key, phone])
  @@index([event_key, created_at(sort: Desc)])
  @@index([email_status, email_next_attempt_at])
  @@index([lead_id])
  @@map("masterclass_registrations")
}
